{
  "name": "visnora",
  "version": "0.1.0",
  "private": true,
  "description": "Visnora — AI-Powered Marketing & Competitive Intelligence SaaS Platform",
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "start": "next start apps/web",
    "postinstall": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/database/prisma/schema.prisma",
    "worker:dev": "tsx packages/jobs/workers/prompt-runner.ts",
    "benchmark:dry-run": "tsx packages/integrations/ai-providers/benchmark-runner.ts --dry-run",
    "benchmark:gemini:test": "node --env-file=.env.local --import tsx packages/integrations/ai-providers/benchmark-runner.ts --provider=google-gemini --limit=3",
    "benchmark:gemini:text": "node --env-file=.env.local --import tsx packages/integrations/ai-providers/benchmark-runner.ts --provider=google-gemini --limit=3",
    "benchmark:gemini:lite": "node --env-file=.env.local --import tsx packages/integrations/ai-providers/benchmark-runner.ts --provider=google-gemini --model=gemini-3.5-flash-lite",
    "benchmark:gemini:grounded": "node --env-file=.env.local --import tsx packages/integrations/ai-providers/benchmark-runner.ts --provider=google-gemini --limit=3 --grounding",
    "benchmark:gemini:full": "node --env-file=.env.local --import tsx packages/integrations/ai-providers/benchmark-runner.ts --provider=google-gemini",
    "benchmark:cost": "tsx packages/domain/billing/cost-calculator.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^6.4.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "bullmq": "^5.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.5.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.29",
    "openai": "^4.85.4",
    "razorpay": "^2.9.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.2",
    "prisma": "^6.4.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
