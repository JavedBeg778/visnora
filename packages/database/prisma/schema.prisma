  openaiAccountId      String       @map("openai_account_id") @db.VarChar(255)
  name                 String       @db.VarChar(255)
  currency             String       @default("USD") @db.VarChar(10)
  timezone             String       @default("UTC") @db.VarChar(50)
  status               String       @default("CONNECTED") @db.VarChar(50)
  reviewStatus         String?      @map("review_status") @db.VarChar(50)
  lastSyncAt           DateTime?    @map("last_sync_at") @db.Timestamptz
  lastSuccessfulSyncAt DateTime?    @map("last_successful_sync_at") @db.Timestamptz
  syncError            String?      @map("sync_error")
  dataFreshnessInfo    Json         @default("{}") @map("data_freshness_info")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
