# =============================================================================
# VISNORA — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# INSTRUCTIONS:
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# Real credentials must be provisioned via secret managers in staging/production.
# =============================================================================

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# DATABASE & STORAGE (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Transaction connection pool URL (Supavisor / port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Auth & Public Storage
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Server-only service role key (NEVER expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# QUEUE & CACHE (Redis / BullMQ / Upstash)
# -----------------------------------------------------------------------------
REDIS_URL="redis://default:[password]@[endpoint]:6379"

# -----------------------------------------------------------------------------
# APPLICATION SECURITY & CREDENTIAL ENCRYPTION
# -----------------------------------------------------------------------------
# 32-byte hexadecimal key for AES-256-GCM encryption of third-party tokens
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# -----------------------------------------------------------------------------
# AI PROVIDERS (Module A: AI Visibility Intelligence)
# -----------------------------------------------------------------------------
# Google Gemini API Key (Recommended primary MVP provider)
GEMINI_API_KEY="AIzaSy..."
# OpenAI Platform API Key (For comparative benchmarking)
OPENAI_API_KEY="sk-proj-..."

# -----------------------------------------------------------------------------
# PAYMENT & BILLING (Razorpay)
# -----------------------------------------------------------------------------
# Razorpay Key ID (Public/Client)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
# Razorpay Key Secret (Server-only)
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
# Webhook secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# -----------------------------------------------------------------------------
# AD PLATFORMS (Milestones M5 & M6 — To be configured when activated)
# -----------------------------------------------------------------------------
# Google Ads API Credentials (M5)
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Meta Marketing & Ad Library API Credentials (M5)
META_APP_ID=""
META_APP_SECRET=""

# OpenAI Ads Advertiser API Configuration (M6)
OPENAI_ADS_PARTNER_CONFIG=""

# -----------------------------------------------------------------------------
# OBSERVABILITY & MONITORING
# -----------------------------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info"

